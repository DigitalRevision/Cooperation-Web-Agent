# Настройки платформы для docker compose. Скопируйте в .env и заполните: cp .env.example .env
# Файл .env содержит секреты и в Git не попадает.

# Токены доступа к API: JSON {"токен": "роль"}, роли user, company_admin, moderator, admin.
# Токен администратора нужен для кнопки «Запустить сбор» в админ-панели. Длинный случайный токен: openssl rand -hex 32
PK_TOKENS='{"ЗАМЕНИТЕ-на-длинный-случайный-токен":"admin"}'

# PostgreSQL. Все данные платформы хранятся в базах PostgreSQL, у каждого раздела своя база (docs/DATABASE.md).
# Пароль владельца баз (промкооп) — задайте до первого запуска: потом его меняют уже внутри базы.
# Пароли ролей сервисов: API видит каталог только на чтение, сбор данных не видит базы пользователей. openssl rand -hex 24
PK_DB_PASSWORD=ЗАМЕНИТЕ-на-случайный-пароль
PK_API_DB_PASSWORD=ЗАМЕНИТЕ-на-случайный-пароль-api
PK_SYNC_DB_PASSWORD=ЗАМЕНИТЕ-на-случайный-пароль-sync
# Краулер (сервис crawler): ищет и обходит сайты предприятий после каждого сбора из реестров
PK_CRAWLER_DB_PASSWORD=ЗАМЕНИТЕ-на-случайный-пароль-crawler

# Уведомления. Токен бота Telegram (@BotFather), ключ сообщества ВКонтакте с правом «сообщения сообщества»,
# секрет вебхука бота (любая строка из букв и цифр, тот же передаётся в setWebhook). Пустые — канал выключен
PK_TG_BOT_TOKEN=
PK_VK_GROUP_TOKEN=
PK_TG_WEBHOOK_SECRET=

# Сбор из реестров (docs/SYNC.md). Время ежедневного запуска — по часовому поясу TZ
PK_SYNC_AT=00:01
TZ=Europe/Volgograd
# Порог выручки новой компании, тыс. ₽ (не меньше 1: компании без выручки не добавляются) и сколько новых за запуск
PK_SYNC_MIN_REVENUE_K=1
PK_SYNC_MAX_NEW=5000
# Продукция: реестр промышленной продукции Минпромторга скачивается раз в столько дней (файл около 420 МБ);
# PK_SYNC_RMSP=1 — ещё и реестр МСП ФНС (архив около 2 ГБ раз в месяц, продукцию в нём указывают 0,15 % предприятий)
PK_SYNC_MPT_DAYS=7
PK_SYNC_RMSP=
# Краулер: запуск после каждого сбора из реестров (1/0; при 0 — только задания повторного обхода из админ-панели),
# искать сайты предприятий без сайта (1/0), не больше N за запуск (0 — всех),
# повторный поиск для одного предприятия — не раньше чем через столько дней
PK_CRAWL_AFTER_SYNC=1
PK_DISCOVER=1
PK_DISCOVER_LIMIT=0
PK_DISCOVER_RECHECK_DAYS=30
# Необязательно: Яндекс Search API (платно, по тарифу Яндекс Облака) — если домены по названию не подтвердились, сайт ищется
# поисковиком. API-ключ сервисного аккаунта с ролью search-api.webSearch.user и идентификатор каталога Облака
PK_YANDEX_SEARCH_KEY=
PK_YANDEX_FOLDER_ID=
# Необязательно: ключ платного Checko API — арбитражные дела, ФССП, реестр недобросовестных поставщиков
PK_CHECKO_KEY=
